# ==============================================================================
# Frontend .gitignore (Next.js / Vercel)
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/
/build

# Misc & OS
.DS_Store
Thumbs.db
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
