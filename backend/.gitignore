# ==============================================================================
# Backend .gitignore (FastAPI / Python / Render)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
env/
venv/
.venv/
ENV/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local databases
app/data/*.db
app/data/*.sqlite
app/data/*.db-wal
app/data/*.db-shm
*.db
*.sqlite

# Local secrets
.env
!.env.example
