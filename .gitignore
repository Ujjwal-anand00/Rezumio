# ==============================================================================
# Git Ignore Configuration for Rezumio Full-Stack Application
# Frontend (Next.js / Vercel) & Backend (FastAPI / Render)
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & Environment Variables (Keep local secrets strictly uncommitted)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
frontend/.env.*.local

# Explicitly preserve safe environment variable templates
!.env.example
!*.env.example
!*.env.local.example
!backend/.env.example
!frontend/.env.example
!frontend/.env.local.example

# ------------------------------------------------------------------------------
# Node.js & Frontend (Vercel Build & Bundler Artifacts)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.vercel
frontend/.vercel
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# Python & Backend (Render Runtime & Bytecode)
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
**/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
backend/env/
backend/venv/
backend/.venv/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
**/*/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Databases & Local Runtime Data
# ------------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
backend/app/data/*.db
backend/app/data/*.sqlite
backend/app/data/*.db-wal
backend/app/data/*.db-shm

# ------------------------------------------------------------------------------
# Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak
*.tmp
*.swp
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
